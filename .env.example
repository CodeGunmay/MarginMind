# MarginMind backend configuration — copy to `.env` and adjust. NEVER commit real secrets.

# Port the API server listens on (default 4000)
PORT=4000

# SQLite database file (auto-created; new owner workspaces start empty)
DATABASE_FILE=./server/data/marginmind.db

# OPTIONAL — real LLM-based recipe extraction.
# If left empty, the server uses the built-in deterministic rule parser instead.
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, Groq, Azure, Ollama, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Mock SMS logs codes on the server. Do not use mock as real phone verification.
SMS_PROVIDER=mock
DEMO_SHOW_OTP=false
# Unimplemented provider stubs (never put credentials in frontend configuration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FIREBASE_SERVICE_ACCOUNT=

# Exact browser origins permitted to submit requests
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
# Set NODE_ENV=production on HTTPS hosting for Secure cookies
